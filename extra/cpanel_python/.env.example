# ==========================================
# Douman Panel Bot - تنظیمات ربات
# ==========================================

# توکن ربات تلگرام (از @BotFather)
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz

# آیدی عددی ادمین اصلی (از @userinfobot)
ADMIN_ID=12345678

# یوزرنیم ربات بدون @
BOT_USERNAME=doumanpanelbot

# آدرس وب‌هوک ربات (مثلاً آدرس اپلیکیشن در سی‌پنل)
WEBHOOK_URL=https://yourdomain.com/bot/webhook

# کلید امنیتی وب‌هوک (اختیاری جهت امنیت بیشتر)
WEBHOOK_SECRET=mysecretkey123456

# نوع دیتابیس: sqlite یا mysql
DB_TYPE=sqlite

# اگر DB_TYPE=mysql باشد مشخصات زیر را وارد کنید:
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cpaneluser_douman
DB_USER=cpaneluser_botuser
DB_PASS=MyStrongPassword123

# شماره کارت بانکی جهت دریافت وجه کارت به کارت
CARD_NUMBER=6037991800000000
CARD_HOLDER=نام و نام خانوادگی صاحب کارت

# مرچنت کد زرین‌پال (اختیاری جهت درگاه پرداخت آنلاین)
ZARINPAL_MERCHANT=
