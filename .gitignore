# Composer-managed dependencies — installed by install.sh at install/update time.
# Never commit these; run `composer install` to recreate them.
/vendor/
!/vendor/autoload.php

# Composer runtime artifacts
composer.phar

# Runtime / generated files
error_log
cronbot/.run.lock
/storage/**
!/storage/cache/
!/storage/.htaccess
!/storage/cache/.htaccess
/api/hash.txt
*.xlsx
graphify-out
docs
/lang/override/
/deploy.sh

# Python artifacts
__pycache__/
*.py[cod]
*.db
*.sqlite3
.env


# Central panel & packages
central_panel/
*.zip
