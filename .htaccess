<IfModule mod_rewrite.c>
    RewriteEngine On
    # Allow existing files and directories (WordPress subfolder safe)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>

<Files "*.txt">
    Require all denied
</Files>
<Files "error_log">
    Require all denied
</Files>
<Files "*.sh">
    Require all denied
</Files>
<Files "composer.lock">
    Require all denied
</Files>
<IfModule mod_alias.c>
    RedirectMatch 404 /\.git
</IfModule>
<Files "*.json">
    Require all denied
</Files>
<Files "*.sql">
    Require all denied
</Files>
<Files "*.zip">
    Require all denied
</Files>

Options -Indexes

<FilesMatch "^error_log$|\.log$|\.log\.[0-9]+$">
    Require all denied
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
